# Copy to .env (git-ignored). Only DISCORD_TOKEN, GUILD_ID and DATABASE_URL are required.
DISCORD_TOKEN=
GUILD_ID=

# Postgres. Same server as FFT (Railway), own schema `marione`.
# On Railway use the private-network URL of the Postgres service.
DATABASE_URL=postgresql://user:password@host:5432/postgres

# AI (optional: with no key the agent stays silent and the rest of the bot works)
OPENROUTER_API_KEY=
# Main model, cheap gate model and fallbacks (comma separated). Any OpenRouter model id.
AGENT_MODEL=anthropic/claude-haiku-4.5
AGENT_GATE_MODEL=google/gemini-2.5-flash-lite
AGENT_FALLBACK_MODELS=
# Spending limits in US dollars, from the real cost OpenRouter reports for every call.
AGENT_DAILY_BUDGET_USD=0.50
AGENT_MONTHLY_BUDGET_USD=10

# Where the web health check listens (Railway sets PORT).
PORT=8080
TIMEZONE=Europe/Rome

# The web page (login with Discord). Create an application at
# https://discord.com/developers/applications, add PUBLIC_URL/auth/callback as an OAuth2 redirect.
# Without these the bot works fully, only the web page cannot log anyone in.
PUBLIC_URL=https://marione.example.com
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# A long random string that signs the login cookie: openssl rand -hex 32
WEB_SESSION_SECRET=
# Channel id where web actions (a heist) are announced. 0 = the server's system channel.
ANNOUNCE_CHANNEL_ID=0

# Music (yt-dlp). YouTube often refuses server addresses ("sign in to confirm you're not a bot");
# songs then come from SoundCloud. For real YouTube paste the CONTENT of a cookies.txt exported
# from a throwaway Google account, and/or a residential proxy URL.
YTDLP_COOKIES=
YTDLP_PROXY=
