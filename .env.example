# Copy to .env (git-ignored). Only DISCORD_TOKEN, GUILD_ID and DATABASE_URL are required.
DISCORD_TOKEN=
GUILD_ID=

# Postgres. Same server as FFT (Railway), own schema `marione`.
# On Railway use the private-network URL of the Postgres service.
DATABASE_URL=postgresql://user:password@host:5432/postgres

# AI (optional: with no key the agent stays silent and the rest of the bot works)
OPENROUTER_API_KEY=
# Main model, cheap gate model and fallbacks (comma separated). Any OpenRouter model id.
AGENT_MODEL=anthropic/claude-haiku-4.5
AGENT_GATE_MODEL=google/gemini-2.5-flash-lite
AGENT_FALLBACK_MODELS=
# Spending limits in US dollars, from the real cost OpenRouter reports for every call.
AGENT_DAILY_BUDGET_USD=0.50
AGENT_MONTHLY_BUDGET_USD=10

# Where the web health check listens (Railway sets PORT).
PORT=8080
TIMEZONE=Europe/Rome
